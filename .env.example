# ==============================================================================
# Qynova ERP - Environment Variables Template
# Copy this file to .env and configure your environment-specific settings.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=5000

# Database Configuration (MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=qynova_erp
DB_ROOT_PASSWORD=your_mysql_root_password

# Authentication & JWT Secrets (Change in production)
JWT_SECRET=your_jwt_secret_key_change_in_production_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Client Application URL (For CORS and email reset links)
CLIENT_URL=http://localhost:5173
VITE_API_URL=/api/v1

# Email & SMTP Configuration (Leave empty to use dev console fallback)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Qynova ERP" <notifications@qynova.erp>
