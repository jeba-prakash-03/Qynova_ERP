# ==============================================================================
# Qynova ERP - Monorepo Environment Variables Template
# Copy this file to .env, backend/.env, and frontend/.env as needed.
# NEVER commit the actual .env file or real secrets to version control.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=5000

# Database Configuration (MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=qynova_erp
DB_ROOT_PASSWORD=your_mysql_root_password

# Authentication & JWT Secrets (Generate strong random secrets for production)
JWT_SECRET=replace_with_a_secure_random_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_secure_random_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Client Application URL (For CORS and email reset links)
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
VITE_API_URL=/api/v1

# Admin Bootstrap (Used during initial essential database seeding)
ADMIN_EMAIL=admin@example.com
ADMIN_NAME="System Administrator"
ADMIN_PASSWORD=your_secure_admin_password

# Email & SMTP Configuration (Leave SMTP_HOST empty to use local dev console fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
SMTP_FROM="Qynova ERP" <notifications@example.com>
EMAIL_FROM=notifications@example.com

# Firebase Cloud Messaging - Backend Admin (Optional: push disabled if omitted)
# Obtain from: Firebase Console -> Project Settings -> Service accounts -> Generate new private key
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_firebase_project_id.iam.gserviceaccount.com
# Paste the private key from your Firebase service account JSON
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_lines_here\n-----END PRIVATE KEY-----\n"

# Firebase Cloud Messaging - Frontend Web Push
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# VAPID Key (Web Push certificate key pair)
# Obtain from: Firebase Console -> Project Settings -> Cloud Messaging -> Web Push certificates
VITE_FIREBASE_VAPID_KEY=your_firebase_vapid_key

# Frontend Branding (Optional)
VITE_APP_NAME=Qynova ERP
VITE_SUPPORT_EMAIL=support@example.com
