# ==============================================================================
# Qynova ERP Frontend - Environment Variables Template
# Copy this file to frontend/.env and configure your environment settings.
# Notice: VITE_* variables are bundled into client-side JavaScript.
# NEVER place private keys or server-side secrets in this file.
# ==============================================================================

# API Base URL (Default connects to backend API via Vite proxy or direct URL)
VITE_API_URL=/api/v1

# Application Branding
VITE_APP_NAME=Qynova ERP
VITE_SUPPORT_EMAIL=support@example.com

# Firebase Cloud Messaging - Web Push
# Obtain from: Firebase Console -> Project Settings -> General (Web App)
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# VAPID Key (Web Push certificate key pair)
# Obtain from: Firebase Console -> Project Settings -> Cloud Messaging -> Web Push certificates -> Key pair
VITE_FIREBASE_VAPID_KEY=your_firebase_vapid_key
