# ==============================================================================
# Qynova ERP Backend - Environment Variables Template
# Copy this file to backend/.env and configure your environment settings.
# NEVER commit the actual .env file or real secrets to version control.
# ==============================================================================

# Server Config
PORT=5000
NODE_ENV=development

# Database Config (MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=qynova_erp

# JWT Config (Generate strong 32+ character secrets for production)
JWT_SECRET=replace_with_a_secure_random_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_secure_random_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS & Client Application URL
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Admin Initial Bootstrap (Used during initial essential database seed)
ADMIN_EMAIL=admin@example.com
ADMIN_NAME="System Administrator"
ADMIN_PASSWORD=your_secure_admin_password

# Email / SMTP Outbox Config (Leave SMTP_HOST empty for local dev console fallback)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_app_password
SMTP_FROM=
EMAIL_FROM=notifications@example.com

# Firebase Cloud Messaging Admin (Optional: push disabled if omitted)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email@your_project_id.iam.gserviceaccount.com
# Format: Paste the private key from your Firebase service account JSON
FIREBASE_PRIVATE_KEY="your_firebase_private_key_here"

# File Upload Storage Directory
UPLOAD_DIR=storage/uploads
