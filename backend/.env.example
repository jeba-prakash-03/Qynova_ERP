# ==============================================================================
# Qynova ERP Backend - Environment Variables Template
# Copy this file to backend/.env and configure your environment settings.
# NEVER commit the actual .env file or real secrets to version control.
# ==============================================================================

# Server Config
PORT=5000
NODE_ENV=development

# Database Config (MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=qynova_erp

# JWT Config (Generate strong 32+ character secrets for production)
JWT_SECRET=replace_with_a_secure_random_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_secure_random_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS & Client Application URL
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Admin Initial Bootstrap (Used during initial essential database seed)
ADMIN_EMAIL=admin@example.com
ADMIN_NAME="System Administrator"
ADMIN_PASSWORD=your_secure_admin_password

# Email / SMTP Outbox Config (Leave SMTP_HOST empty for local dev console fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
SMTP_FROM="Qynova ERP" <notifications@example.com>
EMAIL_FROM=notifications@example.com

# Firebase Cloud Messaging Admin (Service Account for Web Push)
# Obtain from: Firebase Console -> Project Settings -> Service accounts -> Generate new private key
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_firebase_project_id.iam.gserviceaccount.com
# Paste the private_key from service account JSON inside double quotes with \n intact:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_lines_here\n-----END PRIVATE KEY-----\n"

# Firebase Cloud Messaging - Web Client Config (Optional fallback)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_firebase_project_id.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your_firebase_project_id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id
FIREBASE_VAPID_KEY=your_firebase_vapid_key

# File Upload Storage Directory
UPLOAD_DIR=storage/uploads
