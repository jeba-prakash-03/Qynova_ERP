# Server Config
PORT=5000
NODE_ENV=development

# Database Config (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=qynova_erp

# JWT Config
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS & Client
CLIENT_URL=http://localhost:5173

# Email / SMTP Outbox Config (Leave SMTP_HOST empty for dev console fallback)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Qynova ERP" <notifications@qynova.erp>

# Firebase Cloud Messaging Admin (Push notifications disabled if unset)
FIREBASE_PROJECT_ID=qynova-36d21
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

