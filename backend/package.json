{
  "name": "qynova-erp-backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "migrate:make": "knex --knexfile src/db/knexfile.ts migrate:make -x ts",
    "migrate:latest": "knex --knexfile src/db/knexfile.ts migrate:latest",
    "migrate:latest:test": "cross-env NODE_ENV=test knex --knexfile src/db/knexfile.ts migrate:latest",
    "migrate:rollback": "knex --knexfile src/db/knexfile.ts migrate:rollback",
    "seed": "knex --knexfile src/db/knexfile.ts seed:run",
    "seed:run": "knex --knexfile src/db/knexfile.ts seed:run",
    "seed:run:test": "cross-env NODE_ENV=test knex --knexfile src/db/knexfile.ts seed:run",
    "seed:demo": "ts-node src/db/seeds/run-demo-seeds.ts",
    "db:setup": "knex --knexfile src/db/knexfile.ts migrate:latest && knex --knexfile src/db/knexfile.ts seed:run",
    "db:reset:test": "cross-env NODE_ENV=test knex --knexfile src/db/knexfile.ts migrate:rollback --all && cross-env NODE_ENV=test knex --knexfile src/db/knexfile.ts migrate:latest && cross-env NODE_ENV=test knex --knexfile src/db/knexfile.ts seed:run && cross-env NODE_ENV=test ts-node src/db/seeds/run-demo-seeds.ts",
    "test": "cross-env NODE_ENV=test jest --runInBand --detectOpenHandles --forceExit",
    "lint": "eslint src/**/*.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "firebase-admin": "^13.10.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "multer": "^2.4.0",
    "mysql2": "^3.11.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.1.0",
    "pdfkit": "^0.20.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.14.9",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
